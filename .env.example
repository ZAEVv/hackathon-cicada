# Smart Caspian Transit - local settings template.
# Copy to .env (git-ignored) and uncomment what you need. scripts/dev.sh reads .env as
# literal KEY=VALUE lines (no quotes, no $expansion, not sourced); already-exported
# variables take precedence. Everything left commented uses the built-in default.
# Generate a strong token/key:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Never commit a real .env.

# Bearer token for the broker (logist) role. Default dev-broker-token works only for loopback clients.
# BROKER_TOKEN=replace-with-token_urlsafe-32
# Bearer token for the reviewer role. Must differ from the broker token.
# REVIEWER_TOKEN=replace-with-another-token_urlsafe-32
# 1 = never accept the built-in demo tokens (set both tokens above first).
# DISABLE_DEFAULT_TOKENS=1

# 1 = expose /docs, /redoc and /openapi.json (off by default).
# ENABLE_API_DOCS=1
# Extra comma-separated hostnames accepted in the Host header (localhost, 127.0.0.1, [::1] are always allowed).
# ALLOWED_HOSTS=demo.example.internal

# Maximum request body size in bytes (default 65536).
# MAX_BODY_BYTES=65536
# Requests per client per minute, in-memory, per process (default 600).
# RATE_LIMIT_PER_MINUTE=600
# Failed auth attempts per client before blocking (default 20) ...
# AUTH_FAIL_LIMIT=20
# ... within this window in seconds (default 300).
# AUTH_FAIL_WINDOW_SECONDS=300

# HMAC-SHA256 key for the audit hash chain. Enabling it invalidates chains written without it: start with a fresh DB.
# AUDIT_HMAC_KEY=replace-with-token_urlsafe-32
# Separate HMAC keys for the three witness nodes (passed to the API and to each witness container;
# each node uses only its own entry). Changing keys makes existing witness signatures unverifiable.
# LEDGER_WITNESS_KEYS=witness-1=replace-with-key-1,witness-2=replace-with-key-2,witness-3=replace-with-key-3
# Witness node URLs (network mode). Unset outside Docker: the nodes then run inside the API process.
# docker-compose.yml defaults it to the witness-1..3 services.
# LEDGER_WITNESS_URLS=witness-1=http://127.0.0.1:8101,witness-2=http://127.0.0.1:8102,witness-3=http://127.0.0.1:8103
# LEDGER_WITNESS_TIMEOUT=1.5
# SQLite database file (default ./smart_caspian_demo.sqlite3).
# DATABASE_PATH=./smart_caspian_demo.sqlite3

# Corridor graph database (Neo4j 5, bolt). docker compose defaults to the bundled `graph` service
# (bolt://graph:7687); set GRAPH_DB_URL= (empty) there to force the in-memory networkx fallback.
# Unset or unreachable at startup -> networkx with a log line; /api/health shows "graph_backend".
# Note: docker compose reads this file too; inside compose the URL must be bolt://graph:7687.
# GRAPH_DB_URL=bolt://127.0.0.1:7687
# GRAPH_DB_USER=neo4j
# Neo4j requires at least 8 characters. Also sets the bundled container's initial password.
# GRAPH_DB_PASSWORD=replace-with-token_urlsafe-32

# Current weather: open-meteo (default; live Open-Meteo forecast + marine API, no key,
# cached in memory for 30 min; any failure falls back to synthetic) or synthetic (offline).
# WEATHER_PROVIDER=open-meteo
